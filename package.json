{
  "name": "propflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Property and Rental Management SaaS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present"
  },
  "keywords": [
    "propertymanagement",
    "realestate",
    "saas",
    "multitenant",
    "nestjs",
    "nextjs",
    "prisma"
  ],
  "author": "PropFlow AI",
  "license": "UNLICENSED",
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
