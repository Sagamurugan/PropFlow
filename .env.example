# ==============================================================================
# PropFlow AI - Root Environment Configurations
# Copy this file to .env and configure local variables
# ==============================================================================

# Server Configurations
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# Database Settings (Neon PostgreSQL / Local Postgres)
# Replace with Neon URL for production deployments
DATABASE_URL="postgresql://postgres:postgres_secure_password_99@localhost:5432/propflow_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres_secure_password_99@localhost:5432/propflow_db?schema=public"

# Authentication Secrets
JWT_SECRET="super_secret_jwt_key_that_is_at_least_32_characters_long_for_security"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_must_be_longer_than_32_characters"
JWT_REFRESH_EXPIRATION="7d"

# Cloudinary Configs (Media Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# AI Core Engine - Gemini API Configs
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-pro"

# Stripe configurations (for rent tracking & subscription SaaS, if applicable)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
